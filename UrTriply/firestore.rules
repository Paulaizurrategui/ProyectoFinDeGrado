rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== FUNCIONES DE VALIDACIÓN =====
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.esAdmin == true;
    }
    
    function isUserOrAdmin(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // ===== COLECCIÓN /users =====
    match /users/{userId} {
      // Lectura: usuario propio + admin
      allow read: if isUserOrAdmin(userId);
      
      // Escritura: usuario propio + admin
      allow write: if isUserOrAdmin(userId);
      
      // Admin puede actualizar esAdmin flag
      allow update: if isAdmin() && request.resource.data.esAdmin is bool;
      
      // Subcollección /users/{userId}/following
      match /following/{targetId} {
        allow read: if isAuthenticated();
        allow write: if isUserOrAdmin(userId);
      }
    }
    
    // ===== COLECCIÓN /trips =====
    match /trips/{tripId} {
      // Lectura: Todos pueden leer trips publicados
      allow read: if resource.data.status == 'PUBLISHED' || resource.data.status == 'published';
      
      // Lectura: Autor del viaje + admin
      allow read: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      
      // Crear: Usuario autenticado
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      
      // Actualizar: Autor + admin. Además permitimos que usuarios autenticados
      // actualicen exclusivamente los contadores `likes` y `favorites` (incrementos/decrementos).
      allow update: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        (
          // Permitimos actualizaciones que únicamente afectan al/los campo(s) 'likes' y/o 'favorites'.
          // Usamos `request.writeFields()` para admitir transform operations como FieldValue.increment().
          (
            request.writeFields().hasOnly(['likes'])
          ) || (
            request.writeFields().hasOnly(['favorites'])
          ) || (
            request.writeFields().hasOnly(['likes','favorites'])
          )
        )
      );
      
      // Borrar: Autor + admin
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      
      // Subcollección /trips/{tripId}/likes
      match /likes/{uid} {
        allow read: if true; // Públicos
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAuthenticated() && uid == request.auth.uid;
      }
      
      // Subcollección /trips/{tripId}/favorites
      match /favorites/{uid} {
        allow read: if isAuthenticated() && uid == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAuthenticated() && uid == request.auth.uid;
      }
      
      // Subcollección /trips/{tripId}/comments
      match /comments/{commentId} {
        allow read: if true; // Públicos
        allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }
    
    // ===== ADMIN: Acceso a colecciones completas =====
    // Admin puede leer/escribir en cualquier usuario para moderación.
    // También permitimos que el propio usuario lea/escriba su documento.
    match /users/{userId} {
      allow read, write: if isAdmin() || isUserOrAdmin(userId);
    }
    
    // Admin puede leer todos los trips para moderación (subcolecciones y permisos específicos
    // se definen más arriba en el bloque principal /trips/{tripId}).
    
    // Admin puede leer/borrar comentarios para moderación
    match /trips/{tripId}/comments/{commentId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Admin puede ver todos los likes
    match /trips/{tripId}/likes/{uid} {
      allow read: if isAdmin();
    }
    
    // Admin puede ver todos los favoritos
    match /trips/{tripId}/favorites/{uid} {
      allow read: if isAdmin();
    }

    // ===== COLECCIÓN /reports =====
    // Cualquiera autenticado puede crear reportes
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();  // Solo admin puede ver reportes
      allow update, delete: if isAdmin();  // Solo admin puede resolver/descartar
    }
    
    // Default: Denegar todo
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
